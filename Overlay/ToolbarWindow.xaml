<Window x:Class="EasyShot.Overlay.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:EasyShot.UI"
        SizeToContent="WidthAndHeight" MinHeight="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Opacity="0">
    <Window.Resources>
        <Style TargetType="ToolTip" BasedOn="{StaticResource ShotToolTip}" />
        <Style TargetType="Button" BasedOn="{StaticResource ShotButton}">
            <Setter Property="Margin" Value="2,2" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ShotCombo}">
            <Setter Property="Margin" Value="4,2" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Background="#FA1B2330" CornerRadius="11" BorderBrush="#53637D" BorderThickness="1" Padding="6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <DockPanel LastChildFill="True">
            <Thumb x:Name="DragGrip" DockPanel.Dock="Left" Width="18" Margin="0,2,5,2" Cursor="SizeAll"
                   ToolTip="拖动悬浮栏" DragStarted="OnDragStarted" DragDelta="OnDragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" CornerRadius="5">
                            <TextBlock Text="⠿" Foreground="#91A3BD" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Button Content="{ui:ShotIcon Close}" Foreground="#FF9B9B" DockPanel.Dock="Right" VerticalAlignment="Top" Click="OnClose" ToolTip="关闭 · Esc（不保存、不复制）" AutomationProperties.Name="关闭" />
            <WrapPanel x:Name="EditingButtons" VerticalAlignment="Center">
            <Button x:Name="SelectButton" Content="{ui:ShotIcon Select}" Tag="Select" Click="OnToolClick" ToolTip="选择 · 移动选区 / 选中标注" AutomationProperties.Name="选择" />
            <Button x:Name="RectangleButton" Content="{ui:ShotIcon Rectangle}" Tag="Rectangle" Click="OnToolClick" ToolTip="矩形" AutomationProperties.Name="矩形" />
            <Button x:Name="ArrowButton" Content="{ui:ShotIcon Arrow}" Tag="Arrow" Click="OnToolClick" ToolTip="箭头" AutomationProperties.Name="箭头" />
            <Button x:Name="PenButton" Content="{ui:ShotIcon Pen}" Tag="Pen" Click="OnToolClick" ToolTip="画笔" AutomationProperties.Name="画笔" />
            <Button x:Name="TextButton" Content="{ui:ShotIcon Text}" Tag="Text" Click="OnToolClick" ToolTip="文字 · 点击输入，双击编辑" AutomationProperties.Name="文字" />
            <Button x:Name="NumberButton" Content="{ui:ShotIcon Number}" Tag="Number" Click="OnToolClick" ToolTip="序号" AutomationProperties.Name="序号" />
            <Button x:Name="MosaicButton" Content="{ui:ShotIcon Mosaic}" Tag="Mosaic" Click="OnToolClick" ToolTip="马赛克 · 框选像素化区域" AutomationProperties.Name="马赛克" />
            <ComboBox Width="76" SelectedIndex="1" SelectionChanged="OnTextSizeChanged" ToolTip="文字字号">
                <ComboBoxItem Content="18 px" Tag="18" />
                <ComboBoxItem Content="24 px" Tag="24" />
                <ComboBoxItem Content="36 px" Tag="36" />
            </ComboBox>
            <ComboBox x:Name="Colors" Width="74" SelectedIndex="0" SelectionChanged="OnColorChanged" ToolTip="标注颜色（不影响截图框线）">
                <ComboBoxItem Tag="#FF3B30"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FF3B30" Margin="0,0,7,0" /><TextBlock Text="红" /></StackPanel></ComboBoxItem>
                <ComboBoxItem Tag="#FF9500"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FF9500" Margin="0,0,7,0" /><TextBlock Text="橙" /></StackPanel></ComboBoxItem>
                <ComboBoxItem Tag="#FFCC00"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#FFCC00" Margin="0,0,7,0" /><TextBlock Text="黄" /></StackPanel></ComboBoxItem>
                <ComboBoxItem Tag="#34C759"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#34C759" Margin="0,0,7,0" /><TextBlock Text="绿" /></StackPanel></ComboBoxItem>
                <ComboBoxItem Tag="#007AFF"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#007AFF" Margin="0,0,7,0" /><TextBlock Text="蓝" /></StackPanel></ComboBoxItem>
                <ComboBoxItem Tag="#FFFFFF"><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="White" Margin="0,0,7,0" /><TextBlock Text="白" /></StackPanel></ComboBoxItem>
            </ComboBox>
            <ComboBox x:Name="Thicknesses" Width="76" SelectedIndex="1" SelectionChanged="OnThicknessChanged" ToolTip="线条粗细">
                <ComboBoxItem Tag="2"><StackPanel Orientation="Horizontal"><Border Width="14" Height="2" Background="#E7EEFA" Margin="0,0,6,0" /><TextBlock Text="细" /></StackPanel></ComboBoxItem>
                <ComboBoxItem Tag="4"><StackPanel Orientation="Horizontal"><Border Width="14" Height="4" Background="#E7EEFA" Margin="0,0,6,0" /><TextBlock Text="中" /></StackPanel></ComboBoxItem>
                <ComboBoxItem Tag="8"><StackPanel Orientation="Horizontal"><Border Width="14" Height="8" Background="#E7EEFA" Margin="0,0,6,0" /><TextBlock Text="粗" /></StackPanel></ComboBoxItem>
            </ComboBox>
            <Button x:Name="UndoButton" Content="{ui:ShotIcon Undo}" Click="OnUndo" ToolTip="撤销 · Ctrl+Z" AutomationProperties.Name="撤销" />
            <Button x:Name="RedoButton" Content="{ui:ShotIcon Redo}" Click="OnRedo" ToolTip="重做 · Ctrl+Y / Ctrl+Shift+Z" AutomationProperties.Name="重做" />
            <Button Content="{ui:ShotIcon Ocr}" Click="OnOcr" ToolTip="OCR · 离线中英文识别" AutomationProperties.Name="OCR" />
            <Button Content="{ui:ShotIcon Qr}" Click="OnQr" ToolTip="识别二维码 / 条形码" AutomationProperties.Name="二维码" />
            <Button Content="{ui:ShotIcon Confirm}" Foreground="#72E2B1" Click="OnCopy" ToolTip="确认 · Enter（复制，不保存）" AutomationProperties.Name="确认" />
            <Button Content="{ui:ShotIcon Save}" Click="OnSave" ToolTip="保存 · Ctrl+S（是否同时复制由设置决定）" AutomationProperties.Name="保存" />
            <Button Content="{ui:ShotIcon Pin}" Click="OnPin" ToolTip="贴图到屏幕" AutomationProperties.Name="贴图" />
            <Button x:Name="StartScrollButton" Content="{ui:ShotIcon Scroll}" Click="OnStartScroll" ToolTip="长截图 · 使用当前选区手动滚动捕捉" AutomationProperties.Name="长截图" Visibility="Collapsed" />
            </WrapPanel>
        </DockPanel>
        </ScrollViewer>
    </Border>
</Window>
